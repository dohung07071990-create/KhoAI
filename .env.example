# Database and timezone
DB_PATH=./data/khoai.sqlite3
BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh

# --- Camera USB (cắm vào máy chạy FastAPI) ---
# auto = tự dò, ưu tiên camera USB ngoài (index 1,2,... trước, rồi mới tới webcam trong index 0)
# hoặc đặt số cố định (chạy `python -m ai.list_cameras` để biết số nào là camera ngoài),
# hoặc URL (rtsp://..., http://.../video) / đường dẫn thiết bị (/dev/video2)
CAMERA_INDEX=auto
KHOAI_CAMERA_SCAN_MAX=5
KHOAI_CAMERA_FOURCC=MJPG       # đặt NONE nếu camera không lên hình khi ép MJPG
KHOAI_CAMERA_AUTOSTART=1       # 1 = server tự mở camera khi khởi động

# --- AI ---
KHOAI_YOLO_MODEL=yolov8n.pt
KHOAI_AI_DEVICE=cpu
KHOAI_CONFIDENCE=0.35
KHOAI_IMAGE_SIZE=640
KHOAI_FRAME_WIDTH=640
KHOAI_FRAME_HEIGHT=480
KHOAI_DWELL_SECONDS=30

# --- Vùng cấm ---
# foot = điểm chạm sàn (khuyên dùng) | center = tâm thân người | overlap = % diện tích box nằm trong vùng
KHOAI_ZONE_MODE=foot
KHOAI_ZONE_OVERLAP=0.30        # chỉ dùng cho mode overlap
KHOAI_ENTER_FRAMES=2           # số frame liên tiếp ở trong vùng mới báo đỏ (chống nhiễu)
KHOAI_EXIT_FRAMES=4            # số frame liên tiếp ở ngoài vùng mới tắt đỏ
KHOAI_MIN_BOX_HEIGHT=0.08      # bỏ qua box thấp hơn 8% chiều cao khung (ghế, bóng...)
KHOAI_TRUNCATED_FALLBACK=1     # xử lý khi chân người bị cắt ở đáy khung hình

# Optional API server port (run command uses 3000)
PORT=3000
