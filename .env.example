# Database and timezone
DB_PATH=./data/khoai.sqlite3
BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh

# --- Camera USB (cắm vào máy chạy FastAPI) ---
# auto = tự dò, ưu tiên camera USB ngoài (index 1,2,... trước, rồi mới tới webcam trong index 0)
# hoặc đặt số cố định (chạy `python -m ai.list_cameras` để biết số nào là camera ngoài),
# hoặc URL (rtsp://..., http://.../video) / đường dẫn thiết bị (/dev/video2)
CAMERA_INDEX=auto
KHOAI_CAMERA_SCAN_MAX=5
KHOAI_CAMERA_FOURCC=MJPG       # đặt NONE nếu camera không lên hình khi ép MJPG
KHOAI_CAMERA_AUTOSTART=1       # 1 = server tự mở camera khi khởi động

# --- AI ---
KHOAI_YOLO_MODEL=yolov8n.pt
KHOAI_AI_DEVICE=cpu
KHOAI_CONFIDENCE=0.35
KHOAI_IMAGE_SIZE=640
KHOAI_FRAME_WIDTH=640
KHOAI_FRAME_HEIGHT=480
KHOAI_DWELL_SECONDS=30
# KHOAI_PROFILE=demo  # demo | strict; profile defaults apply unless explicitly overridden below
# KHOAI_ENTRY_GRACE_SECONDS=8  # advanced override
# KHOAI_WRONG_ZONE_GRACE_SECONDS=8  # advanced override
KHOAI_DWELL_REVIEW_SECONDS=300
KHOAI_CAMERA_ZONE_ID=external_usb_zone
# Reliability & health watchdog (v0.6.1)
KHOAI_HEALTH_ESCALATION_SECONDS=30
KHOAI_CAMERA_UNSTABLE_DELAY_SECONDS=3.5  # cảnh báo cadence; RFID vẫn fail-closed ngay
KHOAI_STARTUP_GRACE_SECONDS=60
KHOAI_TRACK_HOLD_SECONDS=5
KHOAI_TRACK_STATE_PRESERVE_SECONDS=3.0
# KHOAI_PRESENCE_RELEASE_SECONDS=8  # advanced override
KHOAI_ANONYMOUS_DEBOUNCE_SECONDS=1

# --- Vùng cấm ---
# foot = điểm chạm sàn (khuyên dùng) | center = tâm thân người | overlap = % diện tích box nằm trong vùng
KHOAI_ZONE_MODE=foot
KHOAI_ZONE_OVERLAP=0.30        # chỉ dùng cho mode overlap
KHOAI_ENTER_CONFIRM_SECONDS=0.10
KHOAI_EXIT_CONFIRM_SECONDS=0.20
KHOAI_MIN_BOX_HEIGHT=0.08      # bỏ qua box thấp hơn 8% chiều cao khung (ghế, bóng...)
KHOAI_TRUNCATED_FALLBACK=1     # xử lý khi chân người bị cắt ở đáy khung hình

# Optional API server port (run command uses 3000)
PORT=3000

# MJPEG render độc lập với tốc độ suy luận YOLO (camera USB ngoài)
KHOAI_STREAM_FPS=20
KHOAI_STREAM_JPEG_QUALITY=74

# Bắt buộc: token quản trị cho mọi API ghi từ dashboard
KHOAI_ADMIN_TOKEN=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_MINIMUM_24_CHARS
# Bật tài liệu API chỉ trong môi trường phát triển
KHOAI_ENABLE_OPENAPI=0
# Bắt buộc: API key riêng cho ESP32 RFID và heartbeat
KHOAI_API_KEY=REPLACE_WITH_A_UNIQUE_RANDOM_DEVICE_SECRET_MINIMUM_32_CHARS

# Thời gian giữ access/security logs và incident đã đóng
KHOAI_LOG_RETENTION_DAYS=365
# Evidence: giữ tối đa theo tuổi và dung lượng; ảnh của incident đang mở được bảo vệ
KHOAI_EVIDENCE_MAX_AGE_DAYS=30
KHOAI_EVIDENCE_MAX_BYTES=2147483648

# Quyền RFID có thời hạn tuyệt đối tối đa 60 giây tính từ lúc ghép Track.
KHOAI_AUTH_MAX_SECONDS=60
KHOAI_RFID_TRACK_AUTH_LOSS_SECONDS=0.75
# Khoảng tối thiểu giữa hai ảnh bằng chứng (mặc định 1 giây)
KHOAI_EVIDENCE_INTERVAL_SECONDS=1

# Incident latch and siren window
KHOAI_SIREN_MAX_SECONDS=60
KHOAI_INCIDENT_EVENT_COOLDOWN_SECONDS=3
KHOAI_ADMIN_SESSION_SECONDS=28800
KHOAI_AUTH_FAIL_LIMIT=5
KHOAI_AUTH_FAIL_WINDOW=60

# ESP32-CAM stream URL is configured server-side; browser never connects directly
KHOAI_ESP32_CAM_STREAM_URL=http://ESP32_CAM_IP:81/stream

# Zone persistence path inside Docker volume
KHOAI_ZONE_FILE=/app/data/zone.json

# RFID ticket and conservative track handover thresholds
# Auto-bind is disabled by default until RC522 position relative to camera ROI is verified.
# Enable only after confirming the reader is visible in the camera's entry ROI.
KHOAI_RFID_AUTO_BIND_ENABLED=0
KHOAI_RFID_BIND_STABILITY_SECONDS=0.30
KHOAI_RFID_MAX_PENDING_TICKETS=1024
# KHOAI_RFID_TICKET_SECONDS=20  # advanced override
KHOAI_TRACK_HANDOVER_MAX_DISTANCE_PX=80
KHOAI_TRACK_HANDOVER_MIN_IOU=0.10

# RFID entry ROI is drawn and saved in the web dashboard; no .env edit is required.

# Decision Engine stabilization (normalized frame coordinates / seconds)
# KHOAI_HANDOVER_MATCH_RADIUS=0.08  # advanced override
# KHOAI_HANDOVER_MAX_GAP_SECONDS=3.5  # advanced override
KHOAI_HANDOVER_EDGE_MARGIN_RATIO=0.03
# KHOAI_HANDOVER_EXCLUSION_RADIUS=0.08  # advanced override
KHOAI_HANDOVER_RAW_INSIDE_CONFIRM_SECONDS=0.22
KHOAI_ZONE_EXIT_BUFFER_RATIO=0.02

KHOAI_DECISION_EXIT_HYSTERESIS_SECONDS=0.50

# SUSPICIOUS is a proximity heuristic, not recognition of criminal behavior.
# KHOAI_SUSPICIOUS_SECONDS=30  # advanced override
KHOAI_SUSPICIOUS_GAP_SECONDS=4
KHOAI_SUSPICIOUS_APPROACH_MIN_SECONDS=2
# KHOAI_SUSPICIOUS_APPROACH_COUNT=3  # advanced override
KHOAI_SUSPICIOUS_APPROACH_WINDOW_SECONDS=120

# Decision Engine record/replay (off by default; coordinate-only JSONL, no images)
KHOAI_DECISION_RECORD_ENABLED=0
KHOAI_DECISION_RECORD_PATH=data/decision_replay.jsonl
KHOAI_DECISION_RECORD_MAX_BYTES=20971520
# Outward frame-exit classifier (history includes samples before the edge band)
KHOAI_HANDOVER_EDGE_HISTORY_SECONDS=1.0
KHOAI_HANDOVER_EDGE_MIN_SAMPLES=3
KHOAI_HANDOVER_EDGE_MIN_SPAN_SECONDS=0.08
KHOAI_HANDOVER_EDGE_OUTWARD_SPEED_RATIO=0.01
# Decision replay retention (one active JSONL + one rotated .1 file)
KHOAI_DECISION_RECORD_MAX_AGE_DAYS=7

# Individual administrator account bootstrap (used only when admin_users is empty).
# Set both values before first start; change/remove bootstrap credentials after creating accounts.
KHOAI_BOOTSTRAP_ADMIN_USERNAME=admin
KHOAI_BOOTSTRAP_ADMIN_PASSWORD=
KHOAI_BOOTSTRAP_ADMIN_NAME=Quản trị viên

# Debounce camera cadence warnings only; RFID fail-closed is immediate.

# Optional Telegram Bot integration (disabled by default)
TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_POLL_TIMEOUT=25
TELEGRAM_NOTIFY_INTERVAL=3
TELEGRAM_EVIDENCE_TTL_SECONDS=1800
TELEGRAM_WARNING_SUMMARY_AFTER_SECONDS=7200
TELEGRAM_REPLAY_HOURS=6
TELEGRAM_INCLUDE_PERSON_NAME=0

# Device API key brute-force protection
KHOAI_DEVICE_KEY_FAIL_LIMIT=8
KHOAI_DEVICE_KEY_FAIL_WINDOW=60
